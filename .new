#!/bin/bash\
\
traceroute google.com | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | while read ip\
do\
    location=$(curl -s ipinfo.io/$ip | jq -r '.city + ", " + .country')\
    echo "$ip  ->  $location"\
done
traceroute google.com | awk '/^[0-9]/ {print $1,$2}' | while read hop ip; do\
  loc=$(curl -s ipinfo.io/$ip | jq -r '.city + ", " + .country')\
  echo "Hop $hop : $ip -> $loc"\
done
traceroute -n google.com | awk '/^[0-9]+/ {print $2}' | while read ip; do printf "%-15s -> " "$ip"; curl -s ipinfo.io/$ip | jq -r '.city + ", " + .country'; done
